# Production Runtime Environment Variables for Indian IPO Platform

# Application Configuration
APP_NAME=ipo-platform
APP_ENV=production
LOG_LEVEL=INFO
REPORTS_DIR=/app/reports/daily

# Database Configuration (MySQL 8.0)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://ipo_user:ipo_secure_password_2026@mysql:3306/ipo_db?charset=utf8mb4
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ipo_db
DB_USER=ipo_user
DB_PASSWORD=ipo_secure_password_2026
MYSQL_ROOT_PASSWORD=ipo_root_password_2026

# Cache / Task Queue Configuration (Redis 7.0)
# Format: redis://[:<password>@]<host>:<port>/<db>
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Operational Scheduler Configuration
SCHEDULER_ENABLED=true
BRIEFING_EXECUTION_TIME=09:00
TZ=Asia/Kolkata
