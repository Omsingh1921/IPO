{
  "name": "ipo-mysql-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "tasks.max": "1",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "debezium_user",
    "database.password": "debezium_cdc_secret_2026",
    "database.server.id": "10001",
    "topic.prefix": "ipo_cdc",
    "database.include.list": "ipo_db",
    "table.include.list": "ipo_db.ipo_master,ipo_db.gmp,ipo_db.subscription,ipo_db.financials",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schema-changes.ipo_cdc",
    "snapshot.mode": "initial",
    "tombstones.on.delete": "true",
    "decimal.handling.mode": "double",
    "time.precision.mode": "connect",
    "include.schema.changes": "false"
  }
}
