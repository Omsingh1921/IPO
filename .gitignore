# Git Ignore for Indian IPO Platform

# Environment variables & secrets
.env
*.env
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
venv/
.venv/
ENV/

# Distribution & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.log

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Platform runtime output & scratch
scratch/
reports/daily/*.md
!reports/daily/.gitkeep
!reports/daily/briefing_2026-10-12.md

# Backups
*.zip
*.bak
backup_*/
